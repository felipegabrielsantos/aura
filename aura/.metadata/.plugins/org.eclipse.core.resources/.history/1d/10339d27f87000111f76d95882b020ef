package switchcase;

import java.util.Scanner;

public class main {
    public static void main(String[] args) {
        // Cria o leitor para capturar o que o usuário digitar no console
        Scanner scanner = new Scanner(System.in);
        int cor = 0;

        // Exibe o menu de opções no console
        System.out.println("Escolha a sua cor preferida:");
        System.out.println("1 - Azul");
        System.out.println("2 - Verde");
        System.out.println("3 - Vermelho");
        System.out.println("4 - Amarelo");
        System.out.println("5 - Marrom");
        System.out.print("Digite o número da sua opção: "); // Mantém o cursor na mesma linha

        // Verifica se o usuário realmente digitou um número
        if (scanner.hasNextInt()) {
            cor = scanner.nextInt();

            // Avalia a opção escolhida
            switch (cor) {
                case 1:
                    System.out.println("Sua cor preferida é azul!");
                    break;
                case 2:
                    System.out.println("Sua cor preferida é verde!");
                    break;
                case 3:
                    System.out.println("Sua cor preferida é vermelho!");
                    break;
                case 4:
                    System.out.println("Sua cor preferida é amarelo!");
                    break;
                case 5:
                    System.out.println("Sua cor preferida é marrom!");
                    break;
                default:
                    System.out.println("Você não escolheu uma cor válida!");
                    break;
            }
        } else {
            // Executado caso o usuário digite letras ou símbolos
            System.out.println("Erro: Você deve digitar apenas números inteiros!");
        }

        // Fecha o scanner para liberar memória
        scanner.close();
    }
}


